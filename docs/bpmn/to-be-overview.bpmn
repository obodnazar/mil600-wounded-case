<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBeOverview" targetNamespace="https://example.invalid/mil600/to-be-overview" exporter="MIL600 навчальна модель">
  <bpmn:collaboration id="Collaboration_ToBeOverview">
    <bpmn:participant id="Pool_ToBe" name="Кейс поранення — TO BE (огляд)" processRef="Process_ToBeOverview" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBeOverview" name="Кейс поранення — TO BE (огляд)" isExecutable="false">
    <bpmn:documentation>Огляд для кроку II, 2026-11-26. Деталі, винятки й повтори — у to-be.bpmn. Медичні факти й рішення лишаються в уповноважених джерелах; інтеграції в прототипі синтетичні.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ToBeOverview">
      <bpmn:lane id="Lane_Soldier" name="Військовослужбовець">
        <bpmn:flowNodeRef>Soldier_View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_View</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Medical" name="Медик / заклад">
        <bpmn:flowNodeRef>Start_Injury</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Care_ePMK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Care_Treat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Сервіс «Кейс поранення» в Армія+ (система)">
        <bpmn:flowNodeRef>Sys_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_Case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_Clock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_CertTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_CertSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_Reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_RewardShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_GapTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge_Gaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_SendVLK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_ShowDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork_After</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_OGDCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sys_OGDShow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OGD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Unit" name="Частина: командир, медслужба, супровід">
        <bpmn:flowNodeRef>Unit_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unit_CertPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unit_CertSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unit_RewardOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unit_Refer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unit_Execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Cert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_VLK" name="ВЛК">
        <bpmn:flowNodeRef>VLK_Exam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VLK_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Фінслужба / орган ОГД">
        <bpmn:flowNodeRef>Fin_RewardPay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_OGDConclusion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_OGDDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Injury" name="Поранення">
      <bpmn:outgoing>F_Start_Injury_Care_ePMK</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Care_ePMK" name="Надати допомогу; внести еПМК у МІС ЗСУ">
      <bpmn:incoming>F_Start_Injury_Care_ePMK</bpmn:incoming>
      <bpmn:outgoing>F_Care_ePMK_Sys_Open</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_Open" name="Отримати еПМК, звірити особу й випадок, відкрити кейс">
      <bpmn:incoming>F_Care_ePMK_Sys_Open</bpmn:incoming>
      <bpmn:incoming>F_Unit_Match_Sys_Open</bpmn:incoming>
      <bpmn:outgoing>F_Sys_Open_Gw_Match</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Match" name="Збіг підтверджено?" default="F_Gw_Match_Unit_Match">
      <bpmn:incoming>F_Sys_Open_Gw_Match</bpmn:incoming>
      <bpmn:outgoing>F_Gw_Match_Fork_Case</bpmn:outgoing>
      <bpmn:outgoing>F_Gw_Match_Unit_Match</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Unit_Match" name="Супровід: звірити особу й випадок вручну">
      <bpmn:incoming>F_Gw_Match_Unit_Match</bpmn:incoming>
      <bpmn:outgoing>F_Unit_Match_Sys_Open</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Fork_Case" name="">
      <bpmn:incoming>F_Gw_Match_Fork_Case</bpmn:incoming>
      <bpmn:outgoing>F_Fork_Case_Soldier_View</bpmn:outgoing>
      <bpmn:outgoing>F_Fork_Case_Care_Treat</bpmn:outgoing>
      <bpmn:outgoing>F_Fork_Case_Sys_CertTask</bpmn:outgoing>
      <bpmn:outgoing>F_Fork_Case_Sys_Reward</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Soldier_View" name="Бачити перелік і стан документів та наступний крок">
      <bpmn:incoming>F_Fork_Case_Soldier_View</bpmn:incoming>
      <bpmn:outgoing>F_Soldier_View_End_View</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_View" name="Боєць знає, що далі">
      <bpmn:incoming>F_Soldier_View_End_View</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Care_Treat" name="Лікувати; оформити виписки й переведення">
      <bpmn:incoming>F_Fork_Case_Care_Treat</bpmn:incoming>
      <bpmn:outgoing>F_Care_Treat_Sys_Clock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_Clock" name="Зафіксувати надходження; рахувати строки: довідка 5 днів, ВЛК до 12 міс.">
      <bpmn:incoming>F_Care_Treat_Sys_Clock</bpmn:incoming>
      <bpmn:outgoing>F_Sys_Clock_Join_Docs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Sys_CertTask" name="Поставити частині задачу: довідка про обставини травми">
      <bpmn:incoming>F_Fork_Case_Sys_CertTask</bpmn:incoming>
      <bpmn:outgoing>F_Sys_CertTask_Unit_CertPrep</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Unit_CertPrep" name="Начальник медслужби: скласти довідку">
      <bpmn:incoming>F_Sys_CertTask_Unit_CertPrep</bpmn:incoming>
      <bpmn:outgoing>F_Unit_CertPrep_Unit_CertSign</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Unit_CertSign" name="Рішення командира: підписати довідку">
      <bpmn:incoming>F_Unit_CertPrep_Unit_CertSign</bpmn:incoming>
      <bpmn:outgoing>F_Unit_CertSign_Sys_CertSend</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_Remind" name="Нагадати командиру й супроводу про строк">
      <bpmn:incoming>F_Timer_Cert_Sys_Remind</bpmn:incoming>
      <bpmn:outgoing>F_Sys_Remind_End_Remind</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Remind" name="Нагадування надіслано">
      <bpmn:incoming>F_Sys_Remind_End_Remind</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Sys_CertSend" name="Надіслати довідку закладу й бійцю; зафіксувати отримання">
      <bpmn:incoming>F_Unit_CertSign_Sys_CertSend</bpmn:incoming>
      <bpmn:outgoing>F_Sys_CertSend_Join_Docs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Sys_Reward" name="Зібрати підстави винагороди за стаціонарне лікування">
      <bpmn:incoming>F_Fork_Case_Sys_Reward</bpmn:incoming>
      <bpmn:outgoing>F_Sys_Reward_Unit_RewardOrder</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Unit_RewardOrder" name="Рішення командира: наказ про винагороду">
      <bpmn:incoming>F_Sys_Reward_Unit_RewardOrder</bpmn:incoming>
      <bpmn:outgoing>F_Unit_RewardOrder_Fin_RewardPay</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Fin_RewardPay" name="Фінслужба: нарахувати й виплатити винагороду">
      <bpmn:incoming>F_Unit_RewardOrder_Fin_RewardPay</bpmn:incoming>
      <bpmn:outgoing>F_Fin_RewardPay_Sys_RewardShow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_RewardShow" name="Показати бійцю стан винагороди">
      <bpmn:incoming>F_Fin_RewardPay_Sys_RewardShow</bpmn:incoming>
      <bpmn:outgoing>F_Sys_RewardShow_End_Reward</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Reward" name="Винагороду виплачено й показано">
      <bpmn:incoming>F_Sys_RewardShow_End_Reward</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Join_Docs" name="">
      <bpmn:incoming>F_Sys_Clock_Join_Docs</bpmn:incoming>
      <bpmn:incoming>F_Sys_CertSend_Join_Docs</bpmn:incoming>
      <bpmn:outgoing>F_Join_Docs_Sys_Check</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Sys_Check" name="Перевірити комплектність пакета ВЛК; показати прогалини й автора">
      <bpmn:incoming>F_Join_Docs_Sys_Check</bpmn:incoming>
      <bpmn:outgoing>F_Sys_Check_Gw_Gaps</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Gaps" name="Є прогалини?" default="F_Gw_Gaps_Merge_Gaps">
      <bpmn:incoming>F_Sys_Check_Gw_Gaps</bpmn:incoming>
      <bpmn:outgoing>F_Gw_Gaps_Merge_Gaps</bpmn:outgoing>
      <bpmn:outgoing>F_Gw_Gaps_Sys_GapTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Sys_GapTask" name="Задача автору документа; направлення не блокує">
      <bpmn:incoming>F_Gw_Gaps_Sys_GapTask</bpmn:incoming>
      <bpmn:outgoing>F_Sys_GapTask_Merge_Gaps</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Merge_Gaps" name="">
      <bpmn:incoming>F_Gw_Gaps_Merge_Gaps</bpmn:incoming>
      <bpmn:incoming>F_Sys_GapTask_Merge_Gaps</bpmn:incoming>
      <bpmn:outgoing>F_Merge_Gaps_Unit_Refer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Unit_Refer" name="Рішення: направити на ВЛК (командир або заклад)">
      <bpmn:incoming>F_Merge_Gaps_Unit_Refer</bpmn:incoming>
      <bpmn:outgoing>F_Unit_Refer_Sys_SendVLK</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_SendVLK" name="Передати пакет у ВЛК; зафіксувати отримання">
      <bpmn:incoming>F_Unit_Refer_Sys_SendVLK</bpmn:incoming>
      <bpmn:outgoing>F_Sys_SendVLK_VLK_Exam</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="VLK_Exam" name="ВЛК: огляд, причинний зв’язок">
      <bpmn:incoming>F_Sys_SendVLK_VLK_Exam</bpmn:incoming>
      <bpmn:outgoing>F_VLK_Exam_VLK_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="VLK_Decision" name="Рішення ВЛК: постанова">
      <bpmn:incoming>F_VLK_Exam_VLK_Decision</bpmn:incoming>
      <bpmn:outgoing>F_VLK_Decision_Sys_ShowDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_ShowDecision" name="Показати постанову бійцю й частині; відкрити ОГД">
      <bpmn:incoming>F_VLK_Decision_Sys_ShowDecision</bpmn:incoming>
      <bpmn:outgoing>F_Sys_ShowDecision_Fork_After</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Fork_After" name="">
      <bpmn:incoming>F_Sys_ShowDecision_Fork_After</bpmn:incoming>
      <bpmn:outgoing>F_Fork_After_Unit_Execute</bpmn:outgoing>
      <bpmn:outgoing>F_Fork_After_Sys_OGDCheck</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Unit_Execute" name="Частина: виконати дії за постановою">
      <bpmn:incoming>F_Fork_After_Unit_Execute</bpmn:incoming>
      <bpmn:outgoing>F_Unit_Execute_End_Route</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Route" name="Подальший маршрут визначено">
      <bpmn:incoming>F_Unit_Execute_End_Route</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Sys_OGDCheck" name="Перевірити пакет ОГД: довідка + постанова ВЛК">
      <bpmn:incoming>F_Fork_After_Sys_OGDCheck</bpmn:incoming>
      <bpmn:outgoing>F_Sys_OGDCheck_Fin_OGDConclusion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Fin_OGDConclusion" name="Уповноважений орган: висновок">
      <bpmn:incoming>F_Sys_OGDCheck_Fin_OGDConclusion</bpmn:incoming>
      <bpmn:outgoing>F_Fin_OGDConclusion_Fin_OGDDecision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Fin_OGDDecision" name="Рішення розпорядника коштів: призначити або відмовити">
      <bpmn:incoming>F_Fin_OGDConclusion_Fin_OGDDecision</bpmn:incoming>
      <bpmn:outgoing>F_Fin_OGDDecision_Sys_OGDShow</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Sys_OGDShow" name="Показати рішення й підтвердження виплати">
      <bpmn:incoming>F_Fin_OGDDecision_Sys_OGDShow</bpmn:incoming>
      <bpmn:outgoing>F_Sys_OGDShow_End_OGD</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OGD" name="Результат ОГД показано">
      <bpmn:incoming>F_Sys_OGDShow_End_OGD</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Timer_Cert" name="Строк довідки сплив" attachedToRef="Unit_CertSign" cancelActivity="false">
      <bpmn:outgoing>F_Timer_Cert_Sys_Remind</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Cert">
        <bpmn:timeDate>надходження + 5 календарних днів (лише дії противника)</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_Start_Injury_Care_ePMK" sourceRef="Start_Injury" targetRef="Care_ePMK" />
    <bpmn:sequenceFlow id="F_Care_ePMK_Sys_Open" sourceRef="Care_ePMK" targetRef="Sys_Open" />
    <bpmn:sequenceFlow id="F_Sys_Open_Gw_Match" sourceRef="Sys_Open" targetRef="Gw_Match" />
    <bpmn:sequenceFlow id="F_Gw_Match_Fork_Case" sourceRef="Gw_Match" targetRef="Fork_Case" name="Так">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">identity_and_incident_confirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Gw_Match_Unit_Match" sourceRef="Gw_Match" targetRef="Unit_Match" name="Ні" />
    <bpmn:sequenceFlow id="F_Unit_Match_Sys_Open" sourceRef="Unit_Match" targetRef="Sys_Open" />
    <bpmn:sequenceFlow id="F_Fork_Case_Soldier_View" sourceRef="Fork_Case" targetRef="Soldier_View" />
    <bpmn:sequenceFlow id="F_Fork_Case_Care_Treat" sourceRef="Fork_Case" targetRef="Care_Treat" />
    <bpmn:sequenceFlow id="F_Fork_Case_Sys_CertTask" sourceRef="Fork_Case" targetRef="Sys_CertTask" />
    <bpmn:sequenceFlow id="F_Fork_Case_Sys_Reward" sourceRef="Fork_Case" targetRef="Sys_Reward" />
    <bpmn:sequenceFlow id="F_Soldier_View_End_View" sourceRef="Soldier_View" targetRef="End_View" />
    <bpmn:sequenceFlow id="F_Care_Treat_Sys_Clock" sourceRef="Care_Treat" targetRef="Sys_Clock" />
    <bpmn:sequenceFlow id="F_Sys_CertTask_Unit_CertPrep" sourceRef="Sys_CertTask" targetRef="Unit_CertPrep" />
    <bpmn:sequenceFlow id="F_Unit_CertPrep_Unit_CertSign" sourceRef="Unit_CertPrep" targetRef="Unit_CertSign" />
    <bpmn:sequenceFlow id="F_Unit_CertSign_Sys_CertSend" sourceRef="Unit_CertSign" targetRef="Sys_CertSend" />
    <bpmn:sequenceFlow id="F_Timer_Cert_Sys_Remind" sourceRef="Timer_Cert" targetRef="Sys_Remind" />
    <bpmn:sequenceFlow id="F_Sys_Remind_End_Remind" sourceRef="Sys_Remind" targetRef="End_Remind" />
    <bpmn:sequenceFlow id="F_Sys_Clock_Join_Docs" sourceRef="Sys_Clock" targetRef="Join_Docs" />
    <bpmn:sequenceFlow id="F_Sys_CertSend_Join_Docs" sourceRef="Sys_CertSend" targetRef="Join_Docs" />
    <bpmn:sequenceFlow id="F_Sys_Reward_Unit_RewardOrder" sourceRef="Sys_Reward" targetRef="Unit_RewardOrder" />
    <bpmn:sequenceFlow id="F_Unit_RewardOrder_Fin_RewardPay" sourceRef="Unit_RewardOrder" targetRef="Fin_RewardPay" />
    <bpmn:sequenceFlow id="F_Fin_RewardPay_Sys_RewardShow" sourceRef="Fin_RewardPay" targetRef="Sys_RewardShow" />
    <bpmn:sequenceFlow id="F_Sys_RewardShow_End_Reward" sourceRef="Sys_RewardShow" targetRef="End_Reward" />
    <bpmn:sequenceFlow id="F_Join_Docs_Sys_Check" sourceRef="Join_Docs" targetRef="Sys_Check" />
    <bpmn:sequenceFlow id="F_Sys_Check_Gw_Gaps" sourceRef="Sys_Check" targetRef="Gw_Gaps" />
    <bpmn:sequenceFlow id="F_Gw_Gaps_Merge_Gaps" sourceRef="Gw_Gaps" targetRef="Merge_Gaps" name="Ні" />
    <bpmn:sequenceFlow id="F_Gw_Gaps_Sys_GapTask" sourceRef="Gw_Gaps" targetRef="Sys_GapTask" name="Так">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">technical_gaps_found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Sys_GapTask_Merge_Gaps" sourceRef="Sys_GapTask" targetRef="Merge_Gaps" />
    <bpmn:sequenceFlow id="F_Merge_Gaps_Unit_Refer" sourceRef="Merge_Gaps" targetRef="Unit_Refer" />
    <bpmn:sequenceFlow id="F_Unit_Refer_Sys_SendVLK" sourceRef="Unit_Refer" targetRef="Sys_SendVLK" />
    <bpmn:sequenceFlow id="F_Sys_SendVLK_VLK_Exam" sourceRef="Sys_SendVLK" targetRef="VLK_Exam" />
    <bpmn:sequenceFlow id="F_VLK_Exam_VLK_Decision" sourceRef="VLK_Exam" targetRef="VLK_Decision" />
    <bpmn:sequenceFlow id="F_VLK_Decision_Sys_ShowDecision" sourceRef="VLK_Decision" targetRef="Sys_ShowDecision" />
    <bpmn:sequenceFlow id="F_Sys_ShowDecision_Fork_After" sourceRef="Sys_ShowDecision" targetRef="Fork_After" />
    <bpmn:sequenceFlow id="F_Fork_After_Unit_Execute" sourceRef="Fork_After" targetRef="Unit_Execute" />
    <bpmn:sequenceFlow id="F_Fork_After_Sys_OGDCheck" sourceRef="Fork_After" targetRef="Sys_OGDCheck" />
    <bpmn:sequenceFlow id="F_Unit_Execute_End_Route" sourceRef="Unit_Execute" targetRef="End_Route" />
