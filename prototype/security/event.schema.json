              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "evidence_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              }
            },
            "required": [
              "provider_ref",
              "date",
              "evidence_ref"
            ]
          }
        }
      }
    },
    {
