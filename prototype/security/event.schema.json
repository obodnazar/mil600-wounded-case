                "pattern": "^demo-[a-z0-9-]{1,60}$"
              },
              "document_kind": {
                "enum": [
                  "trauma_certificate",
                  "referral",
                  "medical_summary"
                ]
              },
              "document_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,40}$"
              },
              "evidence_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              }
            },
            "required": [
              "document_ref",
              "document_kind",
              "document_version",
              "evidence_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "document.issued"
