              "document_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,40}$"
              },
              "recipient_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              },
              "recipient_kind": {
                "enum": [
                  "servicemember",
