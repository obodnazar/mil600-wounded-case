            "additionalProperties": false,
            "properties": {
              "document_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              },
              "document_kind": {
                "enum": [
                  "trauma_certificate",
                  "referral",
                  "medical_summary"
                ]
              },
              "document_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,40}$"
