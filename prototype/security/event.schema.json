              }
            },
            "required": [
              "route",
              "packet_ref",
              "packet_revision",
              "recipient_ref",
              "confirmed_at",
              "reason_code",
              "evidence_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "vlk.decision_recorded"
          }
        }
      },
      "then": {
