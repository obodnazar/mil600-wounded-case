              },
              "document_kind": {
                "enum": [
                  "trauma_certificate",
                  "referral",
                  "medical_summary"
                ]
              },
              "document_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,40}$"
              },
