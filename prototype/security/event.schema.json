{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "case-event/1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^demo-[a-z0-9-]{1,60}$"
    },
    "event_type": {
      "enum": [
        "medical.primary_recorded",
        "care.admitted",
        "care.transferred",
        "care.discharged",
        "care.start_confirmed",
        "document.prepared",
        "document.issued",
        "document.corrected",
        "document.withdrawn",
        "document.received",
        "referral.issued",
        "vlk.package_received",
        "vlk.package_returned",
        "vlk.decision_recorded",
        "service.action_confirmed",
        "finance.package_received",
        "finance.status_recorded"
      ]
    },
    "source_system": {
      "enum": [
        "demo-mis",
        "demo-sedo",
        "demo-vlk",
        "demo-finance",
        "demo-service"
      ]
    },
    "source_record_ref": {
      "type": "string",
      "pattern": "^demo-[a-z0-9-]{1,60}$"
    },
    "source_stream": {
      "type": "string",
      "pattern": "^demo-[a-z0-9-]{1,60}$"
    },
    "source_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,40}$"
    },
    "source_order": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^demo-[a-z0-9-]{1,60}$"
    },
    "incident_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^demo-[a-z0-9-]{1,60}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "episode_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^demo-[a-z0-9-]{1,60}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "source_system",
    "source_record_ref",
    "source_stream",
    "source_version",
    "source_order",
    "subject_ref",
    "incident_ref",
    "episode_ref",
    "occurred_at",
    "recorded_at",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "medical.primary_recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "document_kind": {
                "const": "primary_medical_card"
              },
              "document_version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,40}$"
              }
            },
            "required": [
              "document_kind",
              "document_version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "care.admitted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "evidence_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              }
            },
            "required": [
              "provider_ref",
              "date",
              "evidence_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "care.transferred"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "evidence_ref": {
                "type": "string",
                "pattern": "^demo-[a-z0-9-]{1,60}$"
              }
            },
            "required": [
              "provider_ref",
              "date",
              "evidence_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "care.discharged"
